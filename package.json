{
  "name": "midi-step-sequencer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Local 1-8 track, up to 64-step MIDI step sequencer (Svelte + TypeScript) with lookahead scheduling",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --host --port 4173",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run check && npm run test && npm run build"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^4.0.4",
    "@testing-library/svelte": "^5.2.7",
    "@tsconfig/svelte": "^5.0.4",
    "jsdom": "^25.0.1",
    "svelte": "^5.19.0",
    "svelte-check": "^4.1.4",
    "typescript": "~5.7.3",
    "vite": "^5.4.14",
    "vitest": "^2.1.9"
  }
}
